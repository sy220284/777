  "components": {
    "topBar": {
      "height": 54,
      "bg": "canvas",
      "title": "typography.title",
      "sub": "typography.caption",
      "rule": true
    },
    "row": {
      "minHeight": 56,
      "icon": "iconSizes.md",
      "title": "typography.bodyStrong",
      "desc": "typography.bodyQuiet",
      "meta": "typography.caption",
      "divider": "color.rule"
    },
    "card": {
      "bg": "color.raised",
      "radius": "radius.card",
      "shadow": "shadow.card",
      "border": "color.rule",
      "padding": "space.4"
    },
    "dock": {
      "bg": "color.raised",
      "radius": "radius.sheet",
      "shadow": "shadow.dock",
      "margin": "space.3",
      "padding": "space.2"
    },
    "bubble": {
      "user": {
        "bg": "color.accentSoft",
        "fg": "color.ink",
        "radius": "radius.control",
        "maxWidthRatio": 0.8
      },
      "assistant": {
        "bg": "none",
        "fg": "color.ink"
      }
    },
    "sheet": {
      "bg": "color.raised",
      "radius": "semantic.overlayVariants.sheet.radius",
      "shadow": "semantic.overlayVariants.sheet.shadow",
      "padding": "semantic.overlayVariants.sheet.paddingH"
    },
    "menu": {
      "bg": "color.raised",
      "radius": "semantic.overlayVariants.menu.radius",
      "shadow": "semantic.overlayVariants.menu.shadow",
      "padding": "semantic.overlayVariants.menu.paddingH"
    },
    "dialog": {
      "bg": "color.raised",
      "radius": "semantic.overlayVariants.dialog.radius",
      "shadow": "semantic.overlayVariants.dialog.shadow",
      "padding": "semantic.overlayVariants.dialog.paddingH"
    },
    "button": {
      "primary": {
        "bg": "color.accent",
        "bgPressed": "color.accentPressed",
        "fg": "color.onAccent",
        "radius": "radius.pill",
        "height": 44
      },
      "secondary": {
        "bg": "none",
        "border": "color.ruleStrong",
        "fg": "color.ink",
        "radius": "radius.pill",
        "height": 44
      },
      "quiet": {
        "bg": "none",
        "fg": "color.accent",
        "radius": "radius.pill",
        "height": 44
      }
    },
    "status": {
      "running": "color.accent",
      "waiting": "color.warning",
      "failed": "color.danger",
      "done": "color.success"
    }
