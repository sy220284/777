        "fill": "canvas",
        "blur": "none",
        "shadow": "shadow.none",
        "border": "rule"
      },
      "L2_BAR": {
        "fill": "surface",
        "blur": "none",
        "shadow": "shadow.none",
        "border": "rule"
      },
      "L3_CARD": {
        "fill": "raised",
        "blur": "none",
        "shadow": "shadow.card",
        "border": "rule"
      },
      "L4_OVERLAY": {
        "fill": "raised",
        "blur": "blur.overlay",
        "shadow": "shadow.overlay",
        "border": "ruleStrong"
      },
      "L5_SOLID": {
        "fill": "surface",
        "blur": "none",
        "shadow": "shadow.none",
        "border": "rule"
      }
