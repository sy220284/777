ANDROID_17_SYSTEM_IMAGE='system-images;android-37.0;google_apis_ps16k;x86_64'
GRADLE_VERSION=9.8.1
KOTLIN_VERSION=2.4.20
AGP_VERSION=9.4.0
NODE_MIN_MAJOR=24
ACTIONLINT_VERSION=1.7.12
