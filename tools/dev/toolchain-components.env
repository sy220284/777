# 777 开发工具链组件清单。
# 普通组件 Artifact：777-toolchain-<component>-latest
# 大组件按固定分片上传：777-toolchain-<component>-part-XX-latest
BUILD_COMPONENTS='jdk android-core gradle-runtime gradle-deps runtime-cache'
FULL_EXTRA_COMPONENTS='node actionlint emulator android-image-16 android-image-17'
ALL_COMPONENTS="$BUILD_COMPONENTS $FULL_EXTRA_COMPONENTS"

# 单个分片控制在 350 MiB，明显低于 GitHub 连接器 512 MiB 实际下载上限。
TOOLCHAIN_SHARD_BYTES=367001600
GRADLE_DEPS_PARTS=4
ANDROID_IMAGE_16_PARTS=6
ANDROID_IMAGE_17_PARTS=6
