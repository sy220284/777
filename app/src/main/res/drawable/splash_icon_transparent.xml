<?xml version="1.0" encoding="utf-8"?>
<!--
    Deliberately invisible splash artwork.

    Android's system splash can fall back to the launcher icon when no animated icon is supplied.
    This transparent vector keeps cold/warm launch hand-offs to the plain theme background without
    flashing a brand mark. The launcher artwork itself is unchanged.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h1v1h-1z" />
</vector>
