<?xml version="1.0" encoding="utf-8"?>
<!--
    Invisible splash icon, on purpose.

    Android 12+ paints a splash screen on *every* activity creation and always animates whatever
    `windowSplashScreenAnimatedIcon` resolves to. Leaving the attribute out does not remove the
    mark: the system falls back to the launcher icon instead. Pointing it at this blank 1dp vector
    is the only way to keep the launch window to the plain theme background, so a cold start — and
    the recreate that a language or theme change forces — no longer flashes the brand mark over an
    already-running app.

    The brand artwork itself is untouched; it still appears in the launcher icon.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1dp"
    android:height="1dp"
    android:viewportWidth="1"
    android:viewportHeight="1">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h1v1h-1z" />
</vector>
