<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DshMobile" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <!-- Manifest launch theme used while the platform hands off to MainActivity. -->
    <style name="Theme.DshMobile.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="android:windowBackground">@color/window_background</item>
        <!--
            Keep the system splash visually blank. Omitting this attribute lets Android fall back to
            the launcher icon on supported launch paths, which reintroduces the unwanted brand flash.
        -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon_transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.DshMobile</item>
    </style>
</resources>
